# ─── Nimbus Drive configuration ─────────────────────────────────────
# Copy to ".env" (or run `npm run setup` which builds it for you).
# This is the ONLY machine-specific file — everything else is portable.

APP_NAME=Nimbus Drive

# The URL people use in the browser.
#   Local only:            http://localhost:3000
#   Via Cloudflare Tunnel: https://drive.yourdomain.com
BASE_URL=http://localhost:3000

# Where your files live on this machine's disk (created if missing).
#   Windows example:  D:\CloudDrive
#   Linux example:    /srv/drive
STORAGE_ROOT=./storage

# App data: SQLite database, thumbnail cache, trash. Keep the default unless
# you want it on another disk.
DATA_DIR=./data

# The owner account — always allowed, always admin. Everyone else must be
# added in the Admin page allowlist.
ADMIN_EMAIL=you@gmail.com

# Google OAuth credentials — SETUP.md §2 walks through creating these.
# The OAuth client's authorized redirect URI must be exactly:
#   <BASE_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Internal API port (the web app proxies /api to it). Change only on conflict.
API_PORT=4400

# ── Tuning ──────────────────────────────────────────────────────────
# How long a sign-in lasts before Google sign-in is required again.
SESSION_TTL_DAYS=30
# Per-file upload limit.
MAX_UPLOAD_MB=4096
# Deleted items are moved to DATA_DIR/trash instead of being destroyed.
TRASH_ENABLED=true
# Set true when STORAGE_ROOT is on a network share/NAS and hand-pasted files
# don't show up live in the UI (uses polling instead of file events).
WATCH_POLLING=false
